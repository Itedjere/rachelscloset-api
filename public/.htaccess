<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Always https on the live server. Web push, the service worker and the
    # payment return all refuse to work over plain http. Never for localhost,
    # where there is no certificate.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header. Load-bearing here: every signed-in request
    # is a bearer token, and shared-hosting Apache often drops this header
    # before PHP sees it -- which reads as "signed out" on every page.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# The PHP version, for cPanel + CloudLinux + LiteSpeed. The server default is
# 8.2 and Laravel 13 needs 8.3; on the live host public_html IS this folder, so
# the version has to be set here.
#
# ALT-php83, NOT ea-php83. CloudLinux carries two builds of 8.3 and on this host
# only CloudLinux's has the MySQL driver -- ea-php83 answered every page with
# "could not find driver". The command line already uses alt-php83 (the PHP
# Selector), so this also makes the web and `php artisan` the same PHP.
#
# Kept in cPanel's own format and markers: if MultiPHP Manager rewrites it,
# it writes the same text and the checkout stays clean for deploy.sh.
# Ignored by `php artisan serve`.
# php -- BEGIN cPanel-generated handler, do not edit
# Set the “alt-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
